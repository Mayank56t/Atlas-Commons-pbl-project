<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.7</version>
    <relativePath/>
  </parent>

  <groupId>com.research</groupId>
  <artifactId>research-platform</artifactId>
  <version>1.0.0</version>
  <name>Research Platform — Java Integration Service</name>
  <description>Single-file Spring Boot service exposing GET /api/java/status with a real HTTP call to the Python FastAPI health endpoint.</description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <!-- Only Spring Boot Web: embedded Tomcat + REST. No other dependencies.
         The HTTP call to FastAPI uses the JDK built-in java.net.http.HttpClient. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
  </dependencies>

  <build>
    <!-- Package the existing standalone frontend into Spring Boot's standard
         classpath:/static/ directory. The HTML/CSS/JS source remains in
         ../frontend; the resulting Boot app serves it from its own Tomcat. -->
    <resources>
      <resource>
        <directory>../frontend</directory>
        <targetPath>static</targetPath>
        <filtering>false</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
