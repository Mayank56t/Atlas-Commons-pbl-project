# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` — it contains secrets.

# PostgreSQL connection string used by the FastAPI service
DATABASE_URL=postgresql://<DB_USERNAME>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# JWT signing secret — use a long, random string in real deployments
JWT_SECRET=<replace-with-a-long-random-secret>

# Token lifetime in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# Base URL of the FastAPI service (used by the Spring Boot app)
FASTAPI_URL=http://localhost:8000
